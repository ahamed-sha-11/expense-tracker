# Password for the PostgreSQL user (used by the db service in docker-compose.yml)
POSTGRES_PASSWORD=

# Used when running the app outside Docker Compose.
# Inside Docker Compose, docker-compose.yml builds this URL itself with the hostname "db".
DATABASE_URL=postgresql+asyncpg://expense_user:<password>@localhost:5432/expense_tracker

# Key used to encrypt stored LLM API keys
LLM_ENCRYPTION_KEY=
